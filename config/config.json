{
  "version": 1,
  "admin_server": {
    "host": "0.0.0.0",
    "port": 8443,
    "cert_path": "certs/server.crt",
    "key_path": "certs/server.key",
    "thread_strategy": "hybrid",
    "worker_threads": 4,
    "server_id": "sim_vision_01"
  },
  "capture": {
    "fps": 15,
    "data_source_dir": "DataSource",
    "stereo_image_dir": "DataSource/StereoImage",
    "image_width": 1280,
    "image_height": 720,
    "image_channels": 4
  },
  "zmq": {
    "transport": "ipc",
    "hwm": 10,
    "immediate": true,
    "linger_ms": 1000,
    "endpoints": {
      "visual_2d": "ipc:///tmp/zed_vision_visual_2d",
      "visual_3d": "ipc:///tmp/zed_vision_visual_3d",
      "sensor_data": "ipc:///tmp/zed_vision_sensor_data"
    },
    "pub_id": "sim_vision_pub_01"
  },
  "spsc": {
    "queue_size": 8,
    "drop_policy": "newest",
    "cv_timeout_ms": 10
  },
  "parameters": {
    "fps": 15,
    "resolution": "HD720",
    "depth_mode": "NEURAL",
    "exposure_time": 0,
    "gain": 50,
    "analog_gain": 1000,
    "digital_gain": 1,
    "auto_exposure_gain": "On",
    "mem_type": "CPU",
    "target_fps_2d": 15,
    "target_fps_3d": 15,
    "target_fps_sensor": 200
  },
  "log_level": "info"
}
